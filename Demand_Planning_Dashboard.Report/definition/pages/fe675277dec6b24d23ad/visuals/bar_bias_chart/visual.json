{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.11.0/schema.json",
  "name": "bar_bias_chart",
  "position": {
    "x": 1035,
    "y": 220,
    "z": 0,
    "height": 330,
    "width": 545
  },
  "visual": {
    "visualType": "barChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Dim_Date"
                    }
                  },
                  "Property": "Month"
                }
              },
              "queryRef": "Dim_Date.Month",
              "active": true
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "_Measures"
                    }
                  },
                  "Property": "Bias %"
                }
              },
              "queryRef": "_Measures.Bias %"
            }
          ]
        }
      }
    }
  }
}